#!/bin/bash
# HyperMac Power & Battery SMC Management Helper

# 1. Locate smc binary
if [ -x "/usr/local/bin/displaycontrol-smc" ]; then
    SMC="/usr/local/bin/displaycontrol-smc"
elif [ -x "/Applications/HyperMac.app/Contents/Resources/smc" ]; then
    SMC="/Applications/HyperMac.app/Contents/Resources/smc"
elif [ -x "/Applications/DisplayControl.app/Contents/Resources/smc" ]; then
    SMC="/Applications/DisplayControl.app/Contents/Resources/smc"
elif [ -x "/Users/khacdai24/.gemini/antigravity-ide/scratch/DisplayControl/Resources/smc" ]; then
    SMC="/Users/khacdai24/.gemini/antigravity-ide/scratch/DisplayControl/Resources/smc"
elif [ -x "/usr/local/bin/smc" ]; then
    SMC="/usr/local/bin/smc"
elif [ -x "/opt/homebrew/bin/smc" ]; then
    SMC="/opt/homebrew/bin/smc"
else
    SMC="$(which smc 2>/dev/null || true)"
fi

if [ -z "$SMC" ] || [ ! -x "$SMC" ]; then
    echo "ERROR: smc binary not found"
    exit 1
fi

check_key_exists() {
    local key="$1"
    local out
    out=$("$SMC" -k "$key" -r 2>&1 || true)
    if echo "$out" | grep -qv "no data" && echo "$out" | grep -q "$key"; then
        return 0
    else
        return 1
    fi
}

case "$1" in
    status)
        if check_key_exists "CHTE"; then
            OUT=$("$SMC" -k CHTE -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -q "01 00 00 00" || echo "$OUT" | grep -q "16777216"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        elif check_key_exists "CH0B"; then
            OUT=$("$SMC" -k CH0B -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -q "02"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        elif check_key_exists "BCLM"; then
            OUT=$("$SMC" -k BCLM -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -qv "100" && echo "$OUT" | grep -qv "(bytes 64)"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        else
            echo "STATUS_UNKNOWN"
            echo "BYPASS:0"
            exit 0
        fi
        ;;
    charge-off)
        LIMIT="${2:-80}"
        HANDLED=0

        # Method 1: Apple Silicon CHTE (M2, M3, M4, macOS 14.4+)
        if check_key_exists "CHTE"; then
            "$SMC" -k CHTE -w 01000000 >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 2: Apple Silicon CH0B / CH0C (M1, older macOS)
        if check_key_exists "CH0B"; then
            "$SMC" -k CH0B -w 02 >/dev/null 2>&1 && HANDLED=1
            if check_key_exists "CH0C"; then
                "$SMC" -k CH0C -w 02 >/dev/null 2>&1 || true
            fi
        fi

        # Method 3: Intel BCLM (Battery Charge Limit Max)
        if check_key_exists "BCLM"; then
            HEX_LIMIT=$(printf "%02x" "$LIMIT" 2>/dev/null || echo "50")
            "$SMC" -k BCLM -w "$HEX_LIMIT" >/dev/null 2>&1 && HANDLED=1
        fi

        if [ "$HANDLED" -eq 1 ]; then
            echo "CHARGE_OFF_OK"
            exit 0
        else
            echo "ERROR: No supported SMC charging key found"
            exit 1
        fi
        ;;
    charge-on)
        HANDLED=0

        # Method 1: Apple Silicon CHTE
        if check_key_exists "CHTE"; then
            "$SMC" -k CHTE -w 00000000 >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 2: Apple Silicon CH0B / CH0C
        if check_key_exists "CH0B"; then
            "$SMC" -k CH0B -w 00 >/dev/null 2>&1 && HANDLED=1
            if check_key_exists "CH0C"; then
                "$SMC" -k CH0C -w 00 >/dev/null 2>&1 || true
            fi
        fi

        # Method 3: Intel BCLM (100% in hex is 64)
        if check_key_exists "BCLM"; then
            "$SMC" -k BCLM -w 64 >/dev/null 2>&1 && HANDLED=1
        fi

        if [ "$HANDLED" -eq 1 ]; then
            echo "CHARGE_ON_OK"
            exit 0
        else
            echo "ERROR: No supported SMC charging key found"
            exit 1
        fi
        ;;
    fan-count)
        "$SMC" -k FNum -r
        ;;
    fan-info)
        ID="${2:-0}"
        echo "ACTUAL:" $("$SMC" -k "F${ID}Ac" -r 2>/dev/null || true)
        echo "MIN:" $("$SMC" -k "F${ID}Mn" -r 2>/dev/null || true)
        echo "MAX:" $("$SMC" -k "F${ID}Mx" -r 2>/dev/null || true)
        echo "TARGET:" $("$SMC" -k "F${ID}Tg" -r 2>/dev/null || true)
        echo "MODE:" $("$SMC" -k "F${ID}Md" -r 2>/dev/null || true)
        ;;
    fan-set)
        ID="${2:-0}"
        RPM="$3"
        "$SMC" -k Ftst -w 01 2>/dev/null || true
        "$SMC" -k "F${ID}Md" -w 01 2>/dev/null || true
        "$SMC" -k "F${ID}Tg" -w "$RPM" 2>/dev/null || true
        ;;
    fan-auto)
        ID="${2:-0}"
        "$SMC" -k "F${ID}Md" -w 00 2>/dev/null || true
        "$SMC" -k Ftst -w 00 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {status|charge-off [limit]|charge-on|fan-count|fan-info|fan-set|fan-auto}"
        exit 1
        ;;
esac
