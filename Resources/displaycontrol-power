#!/bin/bash
# HyperMac Power & Battery SMC Management Helper

# 1. Locate smc binary
if [ -x "/usr/local/bin/displaycontrol-smc" ]; then
    SMC="/usr/local/bin/displaycontrol-smc"
elif [ -x "/Applications/HyperMac.app/Contents/Resources/smc" ]; then
    SMC="/Applications/HyperMac.app/Contents/Resources/smc"
elif [ -x "/Applications/DisplayControl.app/Contents/Resources/smc" ]; then
    SMC="/Applications/DisplayControl.app/Contents/Resources/smc"
elif [ -x "/Users/khacdai24/.gemini/antigravity-ide/scratch/DisplayControl/Resources/smc" ]; then
    SMC="/Users/khacdai24/.gemini/antigravity-ide/scratch/DisplayControl/Resources/smc"
elif [ -x "/usr/local/bin/smc" ]; then
    SMC="/usr/local/bin/smc"
elif [ -x "/opt/homebrew/bin/smc" ]; then
    SMC="/opt/homebrew/bin/smc"
else
    SMC="$(which smc 2>/dev/null || true)"
fi

if [ -z "$SMC" ] || [ ! -x "$SMC" ]; then
    echo "ERROR: smc binary not found"
    exit 1
fi

check_key_exists() {
    local key="$1"
    local out
    out=$("$SMC" -k "$key" -r 2>&1 || true)
    if echo "$out" | grep -qv "no data" && echo "$out" | grep -q "$key"; then
        return 0
    else
        return 1
    fi
}

call_powerui() {
    local cmd="$1"
    local lim="${2:-80}"
    if [ ! -x "/usr/bin/swift" ] || [ ! -d "/System/Library/PrivateFrameworks/PowerUI.framework" ]; then
        return 1
    fi
    /usr/bin/swift - "$cmd" "$lim" << 'SWIFT_EOF' 2>/dev/null
import Foundation

guard let b = Bundle(path: "/System/Library/PrivateFrameworks/PowerUI.framework"), b.load(),
      let c = (NSClassFromString("PowerUISmartChargeClient") as? NSObject.Type)?.init(),
      let client = c.perform(NSSelectorFromString("initWithClientName:"), with: "HyperMac")?.takeUnretainedValue() as? NSObject else {
    exit(1)
}
typealias BoolFn = @convention(c) (AnyObject, Selector) -> Bool
let isSupp = unsafeBitCast(client.method(for: NSSelectorFromString("isMCLSupported")), to: BoolFn.self)(client, NSSelectorFromString("isMCLSupported"))
guard isSupp else { exit(2) }

let action = CommandLine.arguments.count > 1 ? CommandLine.arguments[1] : "status"
if action == "status" {
    typealias BoolErrFn = @convention(c) (AnyObject, Selector, UnsafeMutablePointer<NSError?>?) -> UInt64
    var err: NSError? = nil
    let enabled = unsafeBitCast(client.method(for: NSSelectorFromString("isMCLCurrentlyEnabled:")), to: BoolErrFn.self)(client, NSSelectorFromString("isMCLCurrentlyEnabled:"), &err)
    typealias UcharErrFn = @convention(c) (AnyObject, Selector, UnsafeMutablePointer<NSError?>?) -> UInt8
    let limit = unsafeBitCast(client.method(for: NSSelectorFromString("getMCLLimitWithError:")), to: UcharErrFn.self)(client, NSSelectorFromString("getMCLLimitWithError:"), &err)
    print("MCL_LIMIT:\(limit)")
    print("BYPASS:\(enabled != 0 ? 1 : 0)")
    exit(0)
} else if action == "charge-off" {
    let limit = UInt8(CommandLine.arguments.count > 2 ? Int(CommandLine.arguments[2]) ?? 80 : 80)
    typealias SetFn = @convention(c) (AnyObject, Selector, UInt8, UnsafeMutablePointer<NSError?>?) -> Bool
    var err: NSError? = nil
    let ok = unsafeBitCast(client.method(for: NSSelectorFromString("setMCLLimit:error:")), to: SetFn.self)(client, NSSelectorFromString("setMCLLimit:error:"), limit, &err)
    if ok { print("CHARGE_OFF_OK"); exit(0) } else { exit(3) }
} else if action == "charge-on" {
    typealias DisableFn = @convention(c) (AnyObject, Selector, UnsafeMutablePointer<NSError?>?) -> Bool
    var err: NSError? = nil
    let ok = unsafeBitCast(client.method(for: NSSelectorFromString("disableMCL:")), to: DisableFn.self)(client, NSSelectorFromString("disableMCL:"), &err)
    if ok { print("CHARGE_ON_OK"); exit(0) } else { exit(4) }
}
SWIFT_EOF
}

case "$1" in
    status)
        if check_key_exists "bfF0"; then
            OUT=$("$SMC" -k bfF0 -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -q "02" || echo "$OUT" | grep -q "[ui8 ]  2" || echo "$OUT" | grep -q "[ui8 ]  1"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        elif check_key_exists "CHTE"; then
            OUT=$("$SMC" -k CHTE -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -q "01 00 00 00" || echo "$OUT" | grep -q "16777216"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        elif check_key_exists "CH0B"; then
            OUT=$("$SMC" -k CH0B -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -q "02"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        elif check_key_exists "BCLM"; then
            OUT=$("$SMC" -k BCLM -r 2>/dev/null || true)
            echo "$OUT"
            if echo "$OUT" | grep -qv "100" && echo "$OUT" | grep -qv "(bytes 64)"; then
                echo "BYPASS:1"
            else
                echo "BYPASS:0"
            fi
            exit 0
        else
            MCL_OUT=$(call_powerui status 2>/dev/null || true)
            if echo "$MCL_OUT" | grep -q "BYPASS:"; then
                echo "$MCL_OUT"
                exit 0
            else
                echo "STATUS_UNKNOWN"
                echo "BYPASS:0"
                exit 0
            fi
        fi
        ;;
    charge-off)
        LIMIT="${2:-80}"
        HANDLED=0

        # Method 1: Apple Silicon bfF0 / bfD0 / bfE0 (Firmware Limit for M3, M4, macOS 15+ / newer firmware)
        if check_key_exists "bfF0"; then
            HEX_UPPER=$(printf "%02x000000" "$LIMIT" 2>/dev/null || echo "50000000")
            LOWER=$((LIMIT > 4 ? LIMIT - 3 : LIMIT))
            HEX_LOWER=$(printf "%02x000000" "$LOWER" 2>/dev/null || echo "4d000000")
            "$SMC" -k bfF0 -w 00 >/dev/null 2>&1 || true
            if check_key_exists "bfD0"; then "$SMC" -k bfD0 -w "$HEX_UPPER" >/dev/null 2>&1 || true; fi
            if check_key_exists "bfE0"; then "$SMC" -k bfE0 -w "$HEX_LOWER" >/dev/null 2>&1 || true; fi
            if "$SMC" -k bfF0 -w 02 >/dev/null 2>&1; then
                HANDLED=1
            fi
        fi

        # Method 2: Apple Silicon CHTE (M2, M3, M4, macOS 14.4+)
        if check_key_exists "CHTE"; then
            "$SMC" -k CHTE -w 01000000 >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 3: Apple Silicon CH0B / CH0C (M1, older macOS)
        if check_key_exists "CH0B"; then
            "$SMC" -k CH0B -w 02 >/dev/null 2>&1 && HANDLED=1
            if check_key_exists "CH0C"; then
                "$SMC" -k CH0C -w 02 >/dev/null 2>&1 || true
            fi
        fi

        # Method 4: Intel BCLM (Battery Charge Limit Max)
        if check_key_exists "BCLM"; then
            HEX_LIMIT=$(printf "%02x" "$LIMIT" 2>/dev/null || echo "50")
            "$SMC" -k BCLM -w "$HEX_LIMIT" >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 5: Native PowerUI MCL via Swift fallback
        if [ "$HANDLED" -eq 0 ]; then
            if call_powerui "charge-off" "$LIMIT" >/dev/null 2>&1; then
                HANDLED=1
            fi
        fi

        if [ "$HANDLED" -eq 1 ]; then
            echo "CHARGE_OFF_OK"
            exit 0
        else
            echo "ERROR: No supported SMC charging key found"
            exit 1
        fi
        ;;
    charge-on)
        HANDLED=0

        # Method 1: Apple Silicon bfF0
        if check_key_exists "bfF0"; then
            "$SMC" -k bfF0 -w 00 >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 2: Apple Silicon CHTE
        if check_key_exists "CHTE"; then
            "$SMC" -k CHTE -w 00000000 >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 3: Apple Silicon CH0B / CH0C
        if check_key_exists "CH0B"; then
            "$SMC" -k CH0B -w 00 >/dev/null 2>&1 && HANDLED=1
            if check_key_exists "CH0C"; then
                "$SMC" -k CH0C -w 00 >/dev/null 2>&1 || true
            fi
        fi

        # Method 4: Intel BCLM (100% in hex is 64)
        if check_key_exists "BCLM"; then
            "$SMC" -k BCLM -w 64 >/dev/null 2>&1 && HANDLED=1
        fi

        # Method 5: Native PowerUI MCL via Swift fallback
        if call_powerui "charge-on" >/dev/null 2>&1; then
            HANDLED=1
        fi

        if [ "$HANDLED" -eq 1 ]; then
            echo "CHARGE_ON_OK"
            exit 0
        else
            echo "ERROR: No supported SMC charging key found"
            exit 1
        fi
        ;;
    fan-count)
        "$SMC" -k FNum -r
        ;;
    fan-info)
        ID="${2:-0}"
        echo "ACTUAL:" $("$SMC" -k "F${ID}Ac" -r 2>/dev/null || true)
        echo "MIN:" $("$SMC" -k "F${ID}Mn" -r 2>/dev/null || true)
        echo "MAX:" $("$SMC" -k "F${ID}Mx" -r 2>/dev/null || true)
        echo "TARGET:" $("$SMC" -k "F${ID}Tg" -r 2>/dev/null || true)
        echo "MODE:" $("$SMC" -k "F${ID}Md" -r 2>/dev/null || true)
        ;;
    version)
        echo "HELPER_VERSION:2"
        ;;
    fan-set)
        ID="${2:-0}"
        RPM="$3"
        # Chỉ nhận số nguyên hợp lệ; chặn mọi đối số lạ (helper chạy bằng root).
        case "$ID" in [0-3]) ;; *) echo "ERROR: invalid fan id"; exit 2 ;; esac
        case "$RPM" in ''|*[!0-9]*) echo "ERROR: invalid rpm"; exit 2 ;; esac
        FMIN=$("$SMC" -k "F${ID}Mn" -r 2>/dev/null | awk '{print int($4)}')
        FMAX=$("$SMC" -k "F${ID}Mx" -r 2>/dev/null | awk '{print int($4)}')
        if [ -z "$FMIN" ] || [ -z "$FMAX" ] || [ "$FMAX" -le 0 ]; then
            echo "ERROR: fan range unavailable"; exit 3
        fi
        if [ "$RPM" -lt "$FMIN" ] || [ "$RPM" -gt "$FMAX" ]; then
            echo "ERROR: rpm out of range ($FMIN-$FMAX)"; exit 2
        fi
        # float32 little-endian hex (vd 3000 -> 00803b45)
        HEX=$(/usr/bin/perl -e 'print unpack("H*", pack("f<", $ARGV[0]))' "$RPM")
        if check_key_exists "Ftst"; then
            "$SMC" -k Ftst -w 01 >/dev/null 2>&1 || true
        fi
        "$SMC" -k "F${ID}Md" -w 01 >/dev/null 2>&1 || { echo "ERROR: mode write failed"; exit 4; }
        "$SMC" -k "F${ID}Tg" -w "$HEX" >/dev/null 2>&1 || { echo "ERROR: target write failed"; exit 4; }
        echo "FAN_SET_OK"
        ;;
    fan-auto)
        ID="${2:-0}"
        case "$ID" in [0-3]) ;; *) echo "ERROR: invalid fan id"; exit 2 ;; esac
        "$SMC" -k "F${ID}Md" -w 00 >/dev/null 2>&1 || true
        "$SMC" -k "F${ID}Tg" -w 00000000 >/dev/null 2>&1 || true
        if check_key_exists "Ftst"; then
            "$SMC" -k Ftst -w 00 >/dev/null 2>&1 || true
        fi
        echo "FAN_AUTO_OK"
        ;;
    *)
        echo "Usage: $0 {status|charge-off [limit]|charge-on|version|fan-count|fan-info|fan-set <id> <rpm>|fan-auto <id>}"
        exit 1
        ;;
esac
